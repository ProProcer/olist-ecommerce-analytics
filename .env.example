# PostgreSQL connection URL used by scripts/export_dataset.py
# (SQLAlchemy format; requires psycopg2 driver)
DB_URL=postgresql+psycopg2://<username>:<password>@localhost:5432/olist_ecommerce

# Individual connection settings (reference values; see sql/ pipeline)
DB_NAME=olist_ecommerce
DB_USER=postgres
DB_PASSWORD=<password>
DB_HOST=localhost
DB_PORT=5432
